# Telegram. Keep the real values only in .env locally or in
# /etc/fitness-bot/fitness-bot.env on the VPS.
TELEGRAM_BOT_TOKEN=
ADMIN_TELEGRAM_ID=
# Wife's Telegram ID. Comma-separated if more than one user is allowed.
ALLOWED_TELEGRAM_IDS=

DATABASE_URL=sqlite+aiosqlite:///data/fitness_bot.sqlite3
TIMEZONE=Asia/Yekaterinburg
MONTHLY_WORKOUT_TARGET=10
REMINDER_SCAN_SECONDS=30
LOG_LEVEL=INFO

# template keeps the bot fully offline. Recommended cloud option: groq.
LLM_PROVIDER=template
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-20b
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=180
